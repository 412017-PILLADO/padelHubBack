# Plantilla de variables de producción. Copiala a `.env` en esta misma carpeta y completá los
# valores. El `.env` real NO va al repo (está en .gitignore): son secretos.
#
#   cp .env.example .env && nano .env
#
# Las marcadas OBLIGATORIA no tienen default: si faltan, el compose se niega a levantar con un
# mensaje que las nombra. Es a propósito — arrancar a medias es peor que no arrancar.

# ── Dominio ────────────────────────────────────────────────────────────────────────────────────
# OBLIGATORIA. Sin el www ni https. Los clubes viven en <slug>.BASE_DOMAIN.
BASE_DOMAIN=padel-hub.com.ar
# OBLIGATORIA. Let's Encrypt manda acá los avisos de vencimiento si algo falla. Usá una que leas.
ACME_EMAIL=tu-email@ejemplo.com

# ── Base de datos ──────────────────────────────────────────────────────────────────────────────
# OBLIGATORIAS. Generalas al azar, no las escribas de memoria:
#   openssl rand -base64 24
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_DATABASE=padeldb
MYSQL_USER=padel

# ── Secretos de la app ─────────────────────────────────────────────────────────────────────────
# OBLIGATORIA. Mínimo 32 caracteres: el back aborta el arranque si es corta o si quedó el default
# de dev (JwtSecretGuard). Generala con:
#   openssl rand -base64 48
PADEL_JWT_SECRET=

# OBLIGATORIA. Con esta entrás a /plataforma, que es de donde se dan de alta los clubes. Si no la
# ponés, no se siembra ningún super-admin y te quedás afuera del panel.
PADEL_PLATFORM_ADMIN_PASSWORD=
PADEL_PLATFORM_ADMIN_EMAIL=admin@padelhub.com

# Zona horaria del negocio (horarios, reservas, reportes).
PADEL_ZONA_NEGOCIO=America/Argentina/Cordoba

# ── Mercado Pago (opcional) ────────────────────────────────────────────────────────────────────
# Dejalas VACÍAS al principio: sin ellas el módulo de pagos queda apagado y la app funciona igual
# con señas por transferencia (alias + comprobante por WhatsApp), que es como viene operando.
#
# Para prenderlo hacen falta las cuatro. La key de cifrado guarda los tokens de cada club en la
# base; generala con:  openssl rand -base64 32
PADEL_CRYPTO_KEY=
PADEL_MP_CLIENT_ID=
PADEL_MP_CLIENT_SECRET=
# Ojo: estas dos tienen que apuntar al dominio real, no a localhost.
PADEL_MP_REDIRECT_URI=https://padel-hub.com.ar/public/pagos/mp/oauth/callback
PADEL_MP_WEBHOOK_BASE_URL=https://padel-hub.com.ar
